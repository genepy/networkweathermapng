# MariaDB tuned for a small board on an SD card: fewer, larger writes.
# A power cut can lose up to the last few seconds of Observium data, which is
# fine for a testbed.
[mariadbd]
skip-log-bin
skip-name-resolve
performance_schema = OFF

innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
# Write the redo log at commit, flush it to disk about once per second
innodb_flush_log_at_trx_commit = 2
innodb_doublewrite = 0
innodb_io_capacity = 100
innodb_io_capacity_max = 200

# Temporary tables in RAM (/tmp is a tmpfs)
tmpdir = /tmp
